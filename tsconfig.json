{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "allowSyntheticDefaultImports": true,
        "paths": {
            "asi-wallet-sdk": ["./dist"],

            "@services/": ["./src/services"],
            "@domain/": ["./src/domain"],

            "@services/*": ["./src/services/*"],
            "@domain/*": ["./src/domain/*"],
        }
    }
}
