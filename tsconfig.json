{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "allowSyntheticDefaultImports": true,
        "paths": {
            "asi-wallet-sdk": [
                "./dist"
            ],
            "@services/": [
                "./src_new/services"
            ],
            "@domains/": [
                "./src_new/domains"
            ],
            "@config": [
                "./src_new/config"
            ],
            "@utils": [
                "./src_new/utils"
            ],
            "@services/*": [
                "./src_new/services/*"
            ],
            "@domains/*": [
                "./src_new/domains/*"
            ],
            "@config/*": [
                "./src_new/config/*"
            ],
            "@utils/*": [
                "./src_new/utils/*"
            ]
        }
    }
}